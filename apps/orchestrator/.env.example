# Postgres shared with the web app (schema owned by Prisma in apps/web).
DATABASE_URL=postgresql://quantumbyte:quantumbyte@localhost:5432/quantumbyte

# A worker is "live" if it heartbeated within this many seconds.
WORKER_TIMEOUT_SECONDS=30

# A worker row with no heartbeat for this long is reaped (removed).
WORKER_REAP_SECONDS=3600

# Seconds to sleep between assignment loops.
POLL_INTERVAL_SECONDS=1

# Max times a single turn is retried before it is failed.
MAX_TURN_ATTEMPTS=3

# How long a project stays pinned to its last worker after going idle (affinity).
AFFINITY_TTL_SECONDS=1800

# Port range allocated to per-project app previews.
PREVIEW_PORT_MIN=4100
PREVIEW_PORT_MAX=4199
